    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary_clr"
            app:cardCornerRadius="5dp"
            app:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">


                <TextView
                    android:id="@+id/companyNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text=""
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/white" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <ImageView
            android:id="@+id/regImage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/no_img" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            android:weightSum="10">


            <TextView
                android:id="@+id/ownerNameText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:drawablePadding="10dp"
                android:gravity="start|center"
                android:padding="3dp"
                android:text="जय भोले आटोडील"
                android:textStyle="bold"
                app:drawableLeftCompat="@drawable/profile"
                app:drawableTint="@color/primary_clr" />

            <ImageView
                android:id="@+id/editReg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:src="@drawable/edit_icn"
                app:tint="@color/primary_clr"
                android:padding="5dp">

            </ImageView>
        </LinearLayout>
        <!--       <TextView
                   android:id="@+id/mobileCall"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:drawablePadding="10dp"
                   android:gravity="start|center"
                   android:padding="3dp"
                   android:text="9685124979"
                   android:textStyle="bold"
                   app:drawableLeftCompat="@drawable/call_icn"
                   app:drawableTint="@color/primary_clr" />-->

        <TextView
            android:id="@+id/addressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:gravity="start|center"
            android:padding="3dp"
            android:text="Khandwa"
            android:textStyle="bold"
            app:drawableLeftCompat="@drawable/ic_address_icn"
            app:drawableTint="@color/primary_clr" />

        <TextView
            android:id="@+id/productText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:gravity="start|center"
            android:padding="3dp"
            android:text="Khandwa"
            android:textStyle="bold"
            app:drawableLeftCompat="@drawable/ic_designation"
            app:drawableTint="@color/primary_clr" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center">

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
