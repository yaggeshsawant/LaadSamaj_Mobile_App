                            android:gravity="center_horizontal"
                            android:padding="5dp"
                            android:text="प्रतिष्ठान का चिन्ह अपलोड करे "
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="10">


                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/cameraPicker1"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:layout_weight="1.5"
                                android:background="@drawable/upload_button_bg"
                                android:drawableStart="@drawable/camera_icon"
                                android:drawableTint="@color/white"
                                android:gravity="center|start"
                                android:paddingStart="17dp"
                                android:text=""
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />


                            <ImageView
                                android:id="@+id/previewImage1"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="6"
                                android:src="@drawable/no_img">

                            </ImageView>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/galleryPicker1"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:layout_weight="1.5"
                                android:background="@drawable/upload_button_bg"
                                android:drawableStart="@drawable/arrow_up"
                                android:drawableTint="@color/white"
                                android:paddingLeft="17dp"
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:padding="5dp"
                            android:text="प्रतिष्ठान की फोटो अपलोड करे "
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="10">


                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/cameraPicker2"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:layout_weight="1.5"
                                android:background="@drawable/upload_button_bg"
                                android:drawableStart="@drawable/camera_icon"
                                android:drawableTint="@color/white"
                                android:gravity="center|start"
                                android:paddingStart="17dp"
                                android:text=""
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />


                            <ImageView
                                android:id="@+id/previewImage2"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="6"
                                android:src="@drawable/no_img">

                            </ImageView>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/galleryPicker2"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:layout_weight="1.5"
                                android:background="@drawable/upload_button_bg"
                                android:drawableStart="@drawable/arrow_up"
                                android:drawableTint="@color/white"
                                android:paddingLeft="17dp"
                                android:textColor="@android:color/white"
                                android:textSize="13sp" />

                        </LinearLayout>

