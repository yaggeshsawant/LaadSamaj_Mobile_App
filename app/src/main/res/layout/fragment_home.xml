<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".FragmentHome">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="ScrollViewCount,UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:weightSum="3"
                tools:context=".MainActivity"
                tools:ignore="MissingClass,UselessParent">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="2"
                        android:background="@color/primary_clr"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="News"
                        android:textColor="#fff"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/news"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center_horizontal"
                        android:layout_weight="8"
                        android:background="@color/white"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:freezesText="true"
                        android:gravity="left|center_vertical"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:paddingLeft="5dip"
                        android:paddingRight="5dip"
                        android:scrollHorizontally="true"
                        android:shadowDx="1.5"
                        android:shadowDy="1.3"
                        android:shadowRadius="1.6"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/red"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>



                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:elevation="3dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <TextView
                            style="@style/frontHeadingStyle"
                            android:text="डायरेक्टरी" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/servicesRecycleId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>



                <io.github.chayanforyou.slider.SliderLayout
                    android:id="@+id/slider"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:background="@drawable/no_img"
                    app:auto_cycle="true"
                    app:indicator_visibility="visible"
                    app:pager_animation="Accordion"
                    app:pager_animation_span="1100" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity=""
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:weightSum="10">

                    <TextView
                        style="@style/frontHeadingStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:layout_weight="5.5"
                        android:text="बिजनेस कैटेगरी" />

                    <ImageView
                        android:id="@+id/searchRegistrationButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center"
                        android:layout_marginEnd="5dp"
                        android:paddingEnd="5dp"
                        android:padding="5dp"
                        android:layout_weight="1.5"
                        android:src="@drawable/search"
                        />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/registerBusinessButton"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|center"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="3"
                        android:background="@drawable/login_button_bk"
                        android:text="@string/register"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>



                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/onlineDirectoryRecycleId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                   >

                </androidx.recyclerview.widget.RecyclerView>


                <androidx.viewpager.widget.ViewPager
                    android:layout_marginTop="10dp"
                    android:id="@+id/addViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <!-- <TextView
                     style="@style/frontHeadingStyle"
                     android:text="Placed Students" />


                 <androidx.recyclerview.widget.RecyclerView
                     android:id="@+id/placedStudentRecycleId"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content" />-->




                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:elevation="3dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <TextView
                            style="@style/frontHeadingStyle"
                            android:text="संख्या" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/countsRecyclerId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:elevation="3dp"
                    app:cardCornerRadius="10dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <TextView
                            style="@style/frontHeadingStyle"
                            android:text="कार्यकारणी" />


                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/allSamajReclycleId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    style="@style/frontHeadingStyle"
                    android:text="पॉपुलर सर्च" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/latestRegRecycleId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!--<TextView
                    style="@style/frontHeadingStyle"
                    android:text="Student Feedback" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stuFeedbackRecycleId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />-->
            </LinearLayout>

        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>




</FrameLayout>
